{
  "name": "tatu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run build && node scripts/dev.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "mcp": "node scripts/mcp.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node --test packages/*/dist/**/*.test.js apps/*/dist/**/*.test.js scripts/*.test.mjs",
    "build": "tsc -b --pretty false && node scripts/build-cloud.mjs",
    "build:cloud": "npm run build",
    "export:site": "node scripts/site-config.mjs && npm run build && node scripts/build-cloud.mjs --export-site",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "ci": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "wrangler": "4.149.0"
  }
}
