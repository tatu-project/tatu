# Optional legacy Node developer/self-hosted runtime only; not online-user setup.
# The mobile/desktop online app needs no local process or model download.
# Local HTTP port for this legacy runtime.
PORT=3000
# Local default. Use ::1 for IPv6 loopback; 0.0.0.0 is only for the container.
TATU_BIND_HOST=127.0.0.1
TATU_TIMEZONE=America/Sao_Paulo
# Optional explicit heartbeat location. Default: alongside the SQLite database.
# TATU_HEARTBEAT_PATH=data/worker-heartbeat.json
TATU_DATABASE_PATH=data/tatu.sqlite
TATU_WORKER_POLL_MS=10000
TATU_LEASE_SECONDS=30
TATU_MAX_ATTEMPTS=3
TATU_EXECUTION_TIMEOUT_MS=25000
# Local, replaceable filesystem outbox for the first delivery channel.
TATU_DELIVERY_DIR=data/deliveries
# Optional comma-separated public HTTPS RSS feeds; no credentials are stored.
# If unset, the worker uses TechCrunch's public Artificial Intelligence feed.
# Set TATU_RSS_FEEDS= explicitly to disable research safely.
# TATU_RSS_FEEDS=
# Optional legacy briefing-only model route; general online chat uses remote providers.
# Leave blank for deterministic facts-only RSS output.
TATU_OLLAMA_MODEL=
TATU_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional legacy assistant request timeout; not a local-model requirement.
TATU_CHAT_TIMEOUT_MS=60000
# The variables above configure only the optional legacy local developer runtime.
# Online deployment settings are configured server-side through the hosting control plane.
# AUTH_MODE=sites
# SITE_ORIGIN=https://your-site.example
# SITE_PROJECT_ID=appgprj_your_project_id
# SITES_OWNER_PRIVATE=1
# Portable Cloudflare Access lane (do not use Sites identity headers here):
# AUTH_MODE=cloudflare-access
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUDIENCE=your-access-application-audience
# SYSTEM_RUN_TOKEN= optional >=32 character operator secret for the portable updater
# SCHEDULER_ENABLED=false until the Sites automation bridge is verified; portable Cron sets true.
# TATU_ENCRYPTION_KEY: runtime-only base64 encoding of exactly 32 random bytes. No sample secret.
# TATU_ENCRYPTION_KEY_ID=v1
# Optional previous key/key ID for a bounded two-key vault rotation:
# TATU_PREVIOUS_ENCRYPTION_KEY
# TATU_PREVIOUS_ENCRYPTION_KEY_ID
# Optional sponsored Groq route, disabled by default; user-owned connections remain separate.
# TATU_ENABLE_SPONSORED_GROQ=false
# TATU_GROQ_API_KEY: runtime secret only, never in client configuration or source.
