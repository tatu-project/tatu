# Local HTTP port for the Tatu health foundation.
PORT=3000
TATU_DATABASE_PATH=data/tatu.sqlite
TATU_WORKER_POLL_MS=10000
TATU_LEASE_SECONDS=30
TATU_MAX_ATTEMPTS=3
TATU_EXECUTION_TIMEOUT_MS=25000
# Local, replaceable filesystem outbox for the first delivery channel.
TATU_DELIVERY_DIR=data/deliveries
# Optional comma-separated public HTTPS RSS feeds; no credentials are stored.
# If unset, the worker uses TechCrunch's public Artificial Intelligence feed.
# Set TATU_RSS_FEEDS= explicitly to disable research safely.
# TATU_RSS_FEEDS=
# Optional loopback-only model route. Leave blank for deterministic facts-only RSS output.
TATU_OLLAMA_MODEL=
TATU_OLLAMA_BASE_URL=http://127.0.0.1:11434
